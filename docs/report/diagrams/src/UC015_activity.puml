@startuml UC015_activity
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam RoundCorner 24
skinparam ArrowColor black
skinparam ArrowThickness 1.1
skinparam ConditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam style strictuml
skinparam activity {
  BackgroundColor white
  BorderColor black
  BorderThickness 1
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam swimlane {
  BorderColor black
  BorderThickness 2
  TitleFontStyle bold
  TitleFontSize 16
}
skinparam wrapWidth 600
mainframe act [UC015_Kiểm duyệt đánh giá]
|Quản trị viên|
start
:Mở khu quản trị, chọn “Kiểm duyệt đánh giá”\n(huy hiệu trên menu hiện số đánh giá chờ duyệt);
|Hệ thống|
:Lấy danh sách đánh giá phân trang, mặc định lọc “Chờ duyệt”;
:Hiển thị danh sách: tour, người viết, số sao, trích đoạn, ngày gửi,\nnhãn “Đã xác thực” nếu gắn với đơn đã hoàn tất;
|Quản trị viên|
if (Đổi bộ lọc trạng thái?) then (Có)
  :Chuyển bộ lọc sang “Đã duyệt”\nhoặc “Tất cả”;
  |Hệ thống|
  :Hiển thị lại danh sách theo bộ lọc;
  |Quản trị viên|
endif
if (Duyệt hoặc bỏ duyệt\nmột đánh giá?) then (Có)
  :Bấm “Duyệt” ở đánh giá đang chờ,\nhoặc “Bỏ duyệt” ở đánh giá đã duyệt;
  |Hệ thống|
  :Duyệt: hiện ở trang chi tiết tour, được tính vào điểm trung bình.\nBỏ duyệt: ẩn khỏi trang công khai, không còn tính vào điểm\ntrung bình, vẫn còn trong danh sách quản trị;
  |Quản trị viên|
endif
if (Trả lời đánh giá?) then (Có)
  :Bấm “Trả lời”, nhập nội dung phản hồi, bấm “Gửi”;
  |Hệ thống|
  if (Nội dung\nkhông rỗng?) then (Có)
    :Ghi lại câu trả lời, hiện ngay dưới đánh giá\nở trang công khai (nếu đã duyệt);
  else (Không)
    :Báo lỗi, không ghi câu trả lời;
  endif
  |Quản trị viên|
endif
if (Xoá đánh giá?) then (Có)
  :Bấm “Xoá” ở một đánh giá bất kỳ;
  |Hệ thống|
  :Xoá hẳn đánh giá, điểm trung bình của tour\nđược tính lại không còn đánh giá đó;
  |Quản trị viên|
endif
|Hệ thống|
:Hiển thị lại danh sách kèm thông báo kết quả,\ncập nhật huy hiệu số đánh giá chờ duyệt;
|Quản trị viên|
:Xem kết quả;
stop
@enduml
