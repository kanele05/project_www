@startuml UC004_activity
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam RoundCorner 24
skinparam ArrowColor black
skinparam ArrowThickness 1.1
skinparam ConditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam style strictuml
skinparam activity {
  BackgroundColor white
  BorderColor black
  BorderThickness 1
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam swimlane {
  BorderColor black
  BorderThickness 2
  TitleFontStyle bold
  TitleFontSize 16
}
skinparam wrapWidth 600
mainframe act [UC004_Quản lý giỏ hàng]
|Khách vãng lai|
start
:Bấm “Thêm vào giỏ” ở trang chi tiết tour\nhoặc trang danh sách;
|Hệ thống|
:Kiểm tra số khách (có ít nhất 1 người lớn, tối đa 30 khách),\nlịch khởi hành còn mở bán và số chỗ còn trống;
if (Hợp lệ\nvà đủ chỗ?) then (Có)
  if (Lịch khởi hành\nđã có trong giỏ?) then (Có)
    :Cộng dồn số khách\nvào dòng cũ;
  else (Không)
    :Thêm một dòng mới\nvào giỏ;
  endif
  :Hiển thị lại trang giỏ hàng\nkèm thông báo thành công;
else (Không)
  :Từ chối thêm vào giỏ, giữ nguyên giỏ,\nhiển thị thông báo lỗi nghiệp vụ;
endif
|Khách vãng lai|
:Mở trang giỏ hàng, xem các dòng kèm ảnh, tên tour,\nngày đi, số khách, thành tiền và tổng tiền;
if (Thay đổi giỏ hàng?) then (Có)
  :Sửa số người lớn/trẻ em của một dòng,\nhoặc bấm “Xoá” một dòng,\nhoặc bấm “Làm rỗng giỏ hàng”;
  |Hệ thống|
  :Ghi lại thay đổi trong phiên làm việc\n(kiểm tra đủ chỗ khi sửa số khách),\ntổng khách của dòng về 0 thì tự xoá dòng;
  :Hiển thị lại trang giỏ hàng\nvới số liệu đã cập nhật;
  |Khách vãng lai|
else (Không)
endif
stop
@enduml
