@startuml UC006_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC006_Đặt tour]

actor "Khách hàng" as kh
boundary "GiaoDien_ThanhToan" as ui
control "Ctrl_DatTour" as ctrl
control "Svc_DatTour" as svc
entity "DotKhoiHanh" as dot
entity "DonDat" as don
kh -> ui : 1: Bấm “Tiến hành đặt tour”
ui -> ctrl : 1.1: trangThanhToan()
opt Chưa đăng nhập hoặc giỏ trống
  ctrl --> ui : 1.2: chuyển tới đăng nhập (UC005) hoặc về giỏ hàng
end
ctrl --> ui : 1.3: render(gioHang, lienHeDienSan)
ui --> kh : 1.4: Hiển thị trang thanh toán
kh -> ui : 2: Sửa liên hệ, chọn hình thức thanh toán,\nnhập tên hành khách
opt «extend» UC007: Nhập mã giảm giá
  kh -> ui : 3: Bấm “Áp dụng”
  ui -> ctrl : 3.1: xemTruocMaGiamGia(ma)  (UC007)
  ctrl --> ui : 3.2: soTienGiam, tongSauGiam
  ui --> kh : 3.3: Hiển thị tổng tiền sau giảm
end
kh -> ui : 4: Bấm “Xác nhận đặt tour”
ui -> ctrl : 4.1: datTour(bieuMau)
ctrl -> ctrl : 4.1.1: kiemTra(bieuMau): liên hệ, hành khách khớp giỏ
alt Dữ liệu không hợp lệ
  ctrl --> ui : 4.2: trả lại trang thanh toán kèm lỗi
  ui --> kh : 4.3: Hiển thị lỗi tại ô nhập, giữ tên đã nhập
else Dữ liệu hợp lệ
  ctrl -> svc : 4.1.2: datTour(nguoiDat, bieuMau, gioHang)
  loop Với từng dòng giỏ hàng
    svc -> dot : 4.1.3: khoaVaDoc(dotKhoiHanh)
    dot --> svc : 4.1.4: soChoThat
    svc -> svc : 4.1.5: kiemTra(): còn mở bán, chưa quá hạn,\nđủ chỗ, tên hành khách; trừ số chỗ
  end
  svc -> svc : 4.1.6: kiemTraLaiMaGiamGia(), sinhMaDon(), tinhTong()
  alt Hết chỗ, quá hạn, hành khách hoặc mã không hợp lệ
    svc --> ctrl : 4.1.7: lỗi nghiệp vụ (huỷ toàn bộ)
    ctrl --> ui : 4.4: về trang giỏ hàng kèm thông báo lỗi
    ui --> kh : 4.5: Hiển thị lỗi nêu tên tour
  else Mọi kiểm tra đạt
    svc -> don : 4.1.8: «create» DonDat(trạng thái Chờ xác nhận)\n+ dòng, hành khách, lịch sử, khoản thanh toán\n+ lượt dùng mã
    don --> svc : 4.1.9: donDaLuu
    svc --> ctrl : 4.1.10: maDon
    ctrl -> ctrl : 4.1.11: lamRongGioHang(), guiEmailXacNhan()
    ctrl --> ui : 4.6: chuyển tới trang thành công kèm mã đơn
    ui --> kh : 4.7: Hiển thị đặt tour thành công
  end
end
@enduml
