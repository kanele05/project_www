@startuml UC003_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC003_Đăng ký tài khoản]

actor "Khách vãng lai" as kh
boundary "GiaoDien_DangKy" as ui
control "Ctrl_DangKy" as ctrl
control "Svc_TaiKhoan" as svc
entity "TaiKhoan" as tk
control "Svc_ThuDienTu" as mail
kh -> ui : 1: Bấm “Đăng ký”
ui -> ctrl : 1.1: bieuMauDangKy()
ctrl --> ui : 1.2: bieuMau
ui --> kh : 1.3: Hiển thị biểu mẫu đăng ký
kh -> ui : 2: Nhập thông tin, bấm “Đăng ký”
ui -> ctrl : 2.1: dangKy(bieuMau)
ctrl -> tk : 2.1.1: kiemTraEmailChuaDangKy(email)
tk --> ctrl : 2.1.2: ketQua
ctrl -> ctrl : 2.1.3: kiemTra(bieuMau): bắt buộc, email, mật khẩu 6-50,\nkhớp mật khẩu, số điện thoại
alt Có ràng buộc không đạt
  ctrl --> ui : 2.2: trả lại biểu mẫu, lỗi tại các ô sai
  ui --> kh : 2.3: Hiển thị lỗi, giữ lại thông tin đã nhập
else Mọi ràng buộc đạt
  ctrl -> svc : 2.1.4: dangKy(bieuMau)
  svc -> svc : 2.1.5: maHoaMatKhau(matKhau)
  svc -> tk : 2.1.6: «create» TaiKhoan(vaiTro = Khách hàng)
  tk --> svc : 2.1.7: taiKhoanDaLuu
  svc -> mail : 2.1.8: guiThuChaoMung(email)\n[sau khi đã lưu; lỗi chỉ ghi nhận nội bộ]
  mail --> svc : 2.1.9: xong
  svc --> ctrl : 2.1.10: dangKyThanhCong
  ctrl --> ui : 2.4: chuyển tới trang đăng nhập kèm thông báo
  ui --> kh : 2.5: Hiển thị “Đăng ký thành công. Mời bạn đăng nhập.”
end
@enduml
