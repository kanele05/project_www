@startuml UC011_activity
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam RoundCorner 24
skinparam ArrowColor black
skinparam ArrowThickness 1.1
skinparam ConditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam style strictuml
skinparam activity {
  BackgroundColor white
  BorderColor black
  BorderThickness 1
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam swimlane {
  BorderColor black
  BorderThickness 2
  TitleFontStyle bold
  TitleFontSize 16
}
skinparam wrapWidth 600
mainframe act [UC011_Cập nhật hồ sơ cá nhân]
|Khách hàng|
start
:Mở menu tài khoản, chọn “Thông tin cá nhân”;
|Hệ thống|
:Hiển thị biểu mẫu với dữ liệu hiện có của tài khoản;
|Khách hàng|
:Sửa họ tên, email, số điện thoại, địa chỉ,\nbấm “Lưu”;
|Hệ thống|
:Kiểm tra họ tên, email, số điện thoại bắt buộc\nvà đúng định dạng;
if (Dữ liệu hợp lệ?) then (Không)
  :Trả lại biểu mẫu kèm lỗi tại đúng ô nhập;
  stop
endif
if (Email chưa thuộc về\ntài khoản khác?) then (Không)
  :Trả lại biểu mẫu kèm lỗi “Email … đã được sử dụng.”\ntại ô email;
  stop
endif
:Cập nhật họ tên, email, số điện thoại, địa chỉ;
:Chuyển lại trang hồ sơ kèm thông báo\ncập nhật thành công;
|Khách hàng|
stop
@enduml
