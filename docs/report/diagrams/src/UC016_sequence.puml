@startuml UC016_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC016_Gửi liên hệ]
actor "Khách vãng lai" as kh
boundary "GiaoDien_LienHe" as ui
control "Ctrl_LienHe" as ctrl
control "Svc_LienHe" as svc
entity "Tour" as tour
entity "LienHe" as lh
entity "New_LienHe" as nlh

kh -> ui : 1: Mở trang “Liên hệ”, hoặc bấm “Liên hệ về tour này”\ntừ trang chi tiết một tour
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrl : 1.1: form(tourId)
activate ctrl #00E5EE
opt Mở từ một tour cụ thể (có tourId)
  hnote over kh, nlh : .
  ctrl -> svc : 1.1.1: layTourDeDienSan(tourId)
  activate svc #00E5EE
  svc -> tour : 1.1.1.1: findById(tourId)
  activate tour #00E5EE
  return 1.1.1.2: tour
  return 1.1.2: tour
end
ctrl --> ui : 1.2: render(contactForm, tourDangHoi)
deactivate ctrl
ui -> kh : 1.3: Hiển thị biểu mẫu liên hệ (tên tour đang hỏi\nhiện sẵn nếu có)
deactivate ui
deactivate kh

kh -> ui : 2: Nhập họ tên, email, số điện thoại (tuỳ chọn),\ntiêu đề, nội dung, bấm “Gửi”
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrl : 2.1: submit(contactForm)
activate ctrl #00E5EE
ctrl -> ctrl : 2.1.1: validate(form): họ tên, email, tiêu đề, nội dung\nbắt buộc, email đúng định dạng
alt Dữ liệu sai định dạng
  hnote over kh, nlh : .
  ctrl -> svc : 2.1.2: layTourDeDienSan(tourId)
  activate svc #00E5EE
  return 2.1.3: tour
  ctrl --> ui : 2.2: render(contactForm kèm lỗi, tourDangHoi)
  ui -> kh : 2.3: Hiển thị lỗi tại đúng ô nhập,\ngiữ nguyên tour đang hỏi
else Dữ liệu hợp lệ
  hnote over kh, nlh : .
  ctrl -> svc : 2.1.4: guiLienHe(form)
  activate svc #00E5EE
  opt Có tourId
    hnote over kh, nlh : .
    svc -> tour : 2.1.4.1: findById(tourId)
    activate tour #00E5EE
    return 2.1.4.2: tour
  end
  create nlh
  svc -> nlh : 2.1.4.3: «create» taoLienHe(hoTen,\nemail, soDienThoai, tieuDe, noiDung,\ntrangThai = “Mới”, tour)
  svc -> lh : 2.1.4.4: save(lienHeMoi)
  activate lh #00E5EE
  return 2.1.4.5: lienHeDaLuu
  destroy nlh
  return 2.1.5: guiThanhCong
  ctrl --> ui : 2.4: redirect:/contact kèm thông báo\n“Đã gửi liên hệ thành công”
  ui -> kh : 2.5: Hiển thị lại trang liên hệ kèm thông báo\n“Đã gửi liên hệ thành công”
end
deactivate ctrl
deactivate ui
deactivate kh
@enduml
