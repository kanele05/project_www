@startuml UC014_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC014_Đánh giá tour đã đi]
actor "Khách hàng" as kh
boundary "GiaoDien_ChiTietTour" as ui
control "Ctrl_Tour" as ctrlt
control "Ctrl_DanhGia" as ctrl
control "Svc_DanhGia" as svc
entity "DanhGia" as dg
entity "New_DanhGia" as ndg
entity "DonDat" as don

kh -> ui : 1: Mở trang chi tiết tour đã đi,\ncuộn tới khối đánh giá
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrlt : 1.1: detail(id, page)
activate ctrlt #00E5EE
ctrlt -> svc : 1.1.1: layDanhGiaDaDuyet(tourId, trang)
activate svc #00E5EE
svc -> dg : 1.1.1.1: findByTourIdAndApprovedTrue\nOrderByCreatedAtDesc(tourId, phanTrang)
activate dg #00E5EE
return 1.1.1.2: trangDanhGia
return 1.1.2: trangDanhGia
ctrlt -> svc : 1.1.3: kiemTraDuDieuKien(taiKhoanId, tourId)
activate svc #00E5EE
svc -> dg : 1.1.3.1: existsByUserIdAndTourId(taiKhoanId, tourId)
activate dg #00E5EE
return 1.1.3.2: daDanhGia
svc -> don : 1.1.3.3: existsCompletedBookingForTour(tourId, taiKhoanId)
activate don #00E5EE
return 1.1.3.4: coDonHoanTat
return 1.1.4: duDieuKien
ctrlt --> ui : 1.2: render(trangDanhGia, duDieuKien)
deactivate ctrlt
alt Chưa đăng nhập, chưa hoàn tất tour này hoặc đã đánh giá rồi
  hnote over kh, don : .
  ui -> kh : 1.3: Hiển thị danh sách đánh giá đã duyệt,\nkhông hiện biểu mẫu đánh giá
else Đủ điều kiện đánh giá
  hnote over kh, don : .
  ui -> kh : 1.4: Hiển thị danh sách đánh giá đã duyệt\nvà biểu mẫu đánh giá
end
deactivate ui
deactivate kh

opt Khách hàng đủ điều kiện gửi đánh giá
  hnote over kh, don : .
  kh -> ui : 2: Chọn số sao, nhập tiêu đề và nội dung,\nbấm “Gửi đánh giá”
  activate kh #00E5EE
  activate ui #00E5EE
  ui -> ctrl : 2.1: submitReview(reviewForm)
  activate ctrl #00E5EE
  ctrl -> ctrl : 2.1.1: validate(form): số sao 1-5, nội dung không rỗng
  alt Dữ liệu không hợp lệ
    hnote over kh, don : .
    ctrl --> ui : 2.2: redirect:/tours/{id} kèm thông báo lỗi nhập
    ui -> kh : 2.3: Hiển thị thông báo lỗi
  else Dữ liệu hợp lệ
    hnote over kh, don : .
    ctrl -> svc : 2.1.2: guiDanhGia(taiKhoanId, form)
    activate svc #00E5EE
    svc -> dg : 2.1.2.1: existsByUserIdAndTourId(taiKhoanId, tourId)
    activate dg #00E5EE
    return 2.1.2.2: daDanhGia
    svc -> don : 2.1.2.3: findCompletedBookingsForTour(tourId, taiKhoanId)
    activate don #00E5EE
    return 2.1.2.4: dsDonHoanTat
    alt Đã đánh giá tour này hoặc chưa có đơn hoàn tất chứa tour này
      hnote over kh, don : .
      svc --> ctrl : 2.1.3: BusinessRuleException\n(review.alreadyReviewed / notEligible)
      ctrl --> ui : 2.4: redirect:/tours/{id} kèm thông báo lỗi
      ui -> kh : 2.5: Hiển thị thông báo không đủ điều kiện đánh giá
    else Đủ điều kiện
      hnote over kh, don : .
      create ndg
      svc -> ndg : 2.1.2.5: «create» taoDanhGia(tour,\ntaiKhoan, soSao, tieuDe, noiDung,\ndaDuyet = false, donBangChung)
      svc -> dg : 2.1.2.6: save(danhGiaMoi)
      activate dg #00E5EE
      return 2.1.2.7: danhGiaDaLuu
      destroy ndg
      svc --> ctrl : 2.1.4: guiThanhCong
      ctrl --> ui : 2.6: redirect:/tours/{id} kèm thông báo đang chờ duyệt
      ui -> kh : 2.7: Hiển thị thông báo đang chờ quản trị viên duyệt;\nđánh giá chưa hiện công khai
    end
    deactivate svc
  end
  deactivate ctrl
  deactivate ui
  deactivate kh
end
@enduml
