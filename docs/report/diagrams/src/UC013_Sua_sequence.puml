@startuml UC013_Sua_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC013_Quản lý danh mục tour - Sửa danh mục]

actor "Quản trị viên" as kh
boundary "GiaoDien_DanhMuc" as ui
control "Ctrl_DanhMuc" as ctrl
control "Svc_DanhMuc" as svc
entity "DanhMuc" as dm
kh -> ui : 1: Bấm “Sửa” ở một danh mục
ui -> ctrl : 1.1: bieuMauSua(maDanhMuc)
ctrl -> svc : 1.1.1: layDanhMuc(maDanhMuc)
svc -> dm : 1.1.2: findById(maDanhMuc)
dm --> svc : 1.1.3: danhMuc
svc --> ctrl : 1.1.4: danhMuc
ctrl --> ui : 1.2: bieuMau (dữ liệu hiện tại)
ui --> kh : 1.3: Hiển thị biểu mẫu sửa với dữ liệu hiện tại
kh -> ui : 2: Sửa tên, mô tả, ảnh, trạng thái, bấm “Lưu”
ui -> ctrl : 2.1: luu(bieuMau)
ctrl -> ctrl : 2.1.1: kiemTra(bieuMau): tên ≤ 100, mô tả ≤ 500 ký tự
alt Dữ liệu không hợp lệ
  ctrl --> ui : 2.2: trả lại biểu mẫu kèm lỗi
  ui --> kh : 2.3: Hiển thị lỗi tại đúng ô
else Dữ liệu hợp lệ
  ctrl -> svc : 2.1.2: luu(bieuMau)
  svc -> dm : 2.1.3: tonTaiTenKhac(ten, maDanhMuc)
  dm --> svc : 2.1.4: ketQua
  alt Tên trùng danh mục khác
    svc --> ctrl : 2.1.5: lỗi “Danh mục ... đã tồn tại.”
    ctrl --> ui : 2.4: trả lại biểu mẫu kèm lỗi tại ô tên
    ui --> kh : 2.5: Hiển thị lỗi, giữ nguyên giá trị vừa sửa
  else Tên hợp lệ
    svc -> svc : 2.1.6: sinhDuongDanDuyNhat(ten)
    opt Có chọn ảnh mới
      svc -> svc : 2.1.7: luuAnhMoi(anh)
    end
    svc -> dm : 2.1.8: capNhat(ten, moTa, duongDan, hienThi, anh)
    dm --> svc : 2.1.9: danhMucDaLuu
    opt Có ảnh mới và ảnh cũ là ảnh tự tải lên
      svc -> svc : 2.1.10: xoaAnhCuSauKhiLuu()
    end
    svc --> ctrl : 2.1.11: danhMucDaLuu
    ctrl --> ui : 2.6: chuyển về danh sách kèm thông báo
    ui --> kh : 2.7: Hiển thị danh sách và thông báo cập nhật thành công
  end
end

@enduml
