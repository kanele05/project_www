@startuml UC013_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC013_Áp dụng mã giảm giá]
actor "Khách hàng" as kh
boundary "GiaoDien_ThanhToan" as ui
control "Ctrl_KhuyenMai" as ctrl
control "Svc_KhuyenMai" as svc
entity "MaGiamGia" as ma
entity "LuotDungMa" as lt

kh -> ui : 1: Nhập mã giảm giá, bấm “Áp dụng”
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrl : 1.1: check(code)\n[GET /api/promotions/check]
activate ctrl #00E5EE
ctrl -> ctrl : 1.1.1: tongTien = gioHang.getTotalAmount()\n[đọc giỏ hàng trong phiên]
ctrl -> svc : 1.1.2: kiemTraMa(code, taiKhoanId, tongTien)
activate svc #00E5EE
svc -> ma : 1.1.2.1: findByCodeIgnoreCase(code)
activate ma #00E5EE
return 1.1.2.2: maGiamGia
alt Mã không tồn tại, không hoạt động, ngoài thời gian hiệu lực hoặc hết lượt chung
  hnote over kh, lt : .
  svc --> ctrl : 1.1.3: BusinessRuleException\n(coupon.notFound / expired / outOfQuota)
else Mã còn hiệu lực
  hnote over kh, lt : .
  svc -> lt : 1.1.2.3: countByPromotionIdAndUserId(maId, taiKhoanId)
  activate lt #00E5EE
  return 1.1.2.4: soLanDaDung
  alt Tài khoản đã dùng hết lượt riêng
    hnote over kh, lt : .
    svc --> ctrl : 1.1.4: BusinessRuleException(coupon.usedByUser)
  else Còn lượt riêng
    hnote over kh, lt : .
    svc -> ma : 1.1.2.5: tinhTienGiam(tongTien)\n[% có áp trần hoặc số tiền cố định]
    activate ma #00E5EE
    return 1.1.2.6: soTienGiam
    alt Giỏ hàng chưa đạt giá trị tối thiểu (số tiền giảm = 0)
      hnote over kh, lt : .
      svc --> ctrl : 1.1.5: BusinessRuleException(coupon.minOrder)
    else Đạt giá trị tối thiểu
      hnote over kh, lt : .
      svc --> ctrl : 1.1.6: ketQuaKiemTra(maGiamGia, soTienGiam)
    end
  end
end
deactivate svc
alt Mã bị từ chối
  hnote over kh, lt : .
  ctrl --> ui : 1.2: 4xx JSON {message}
  ui -> kh : 1.3: Hiển thị lý do bị từ chối,\ntổng tiền giữ nguyên
else Mã được chấp nhận
  hnote over kh, lt : .
  ctrl --> ui : 1.2: 200 JSON {code, name, discount,\ntotalBefore, totalAfter}
  ui -> kh : 1.3: Hiển thị lại tổng tiền đã trừ giảm giá\nmà không tải lại trang
end
deactivate ctrl
deactivate ui
deactivate kh
@enduml
