@startuml UC017_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC017_Quản lý liên hệ]
actor "Quản trị viên" as ad
boundary "GiaoDien_QuanLyLienHe" as ui
control "Ctrl_QuanLyLienHe" as ctrl
control "Svc_LienHe" as svc
control "Svc_TaiKhoan" as svck
entity "LienHe" as lh

ad -> ui : 1: Chọn “Quản lý liên hệ”
activate ad #00E5EE
activate ui #00E5EE
ui -> ctrl : 1.1: list(status = NEW, page)
activate ctrl #00E5EE
ctrl -> svc : 1.1.1: layDanhSach(trangThai, trang)
activate svc #00E5EE
svc -> lh : 1.1.1.1: findByStatusOrderByCreatedAtDesc(trangThai, phanTrang)
activate lh #00E5EE
return 1.1.1.2: trangLienHe
return 1.1.2: trangLienHe
ctrl -> svc : 1.1.3: demLienHeMoi()
activate svc #00E5EE
svc -> lh : 1.1.3.1: countByStatus(NEW)
activate lh #00E5EE
return 1.1.3.2: soLienHeMoi
return 1.1.4: soLienHeMoi
ctrl --> ui : 1.2: render(trangLienHe, soLienHeMoi)
deactivate ctrl
ui -> ad : 1.3: Hiển thị danh sách “Mới” và số liên hệ mới trên menu
deactivate ui
deactivate ad

opt Quản trị viên đổi bộ lọc trạng thái
  hnote over ad, lh : .
  ad -> ui : 2: Chuyển bộ lọc sang “Đang xử lý”, “Đã xử lý”,\n“Thư rác” hoặc “Tất cả”
  activate ad #00E5EE
  activate ui #00E5EE
  ui -> ctrl : 2.1: list(status, page)
  activate ctrl #00E5EE
  ctrl -> svc : 2.1.1: layDanhSach(trangThai, trang)
  activate svc #00E5EE
  svc -> lh : 2.1.1.1: findByStatus... / findAll...(phanTrang)
  activate lh #00E5EE
  return 2.1.1.2: trangLienHe
  return 2.1.2: trangLienHe
  ctrl --> ui : 2.2: render(trangLienHe)
  deactivate ctrl
  ui -> ad : 2.3: Hiển thị danh sách theo bộ lọc
  deactivate ui
  deactivate ad
end

ad -> ui : 3: Mở một liên hệ, nhập nội dung trả lời, chọn trạng thái mới,\nbấm “Cập nhật”
activate ad #00E5EE
activate ui #00E5EE
ui -> ctrl : 3.1: updateStatus(id, newStatus, replyNote)
activate ctrl #00E5EE
ctrl -> svck : 3.1.1: layTaiKhoan(quanTriVienId)
activate svck #00E5EE
return 3.1.2: quanTriVien
ctrl -> svc : 3.1.3: capNhatTrangThai(id, trangThaiMoi,\nquanTriVien, noiDungTraLoi)
activate svc #00E5EE
svc -> lh : 3.1.3.1: findById(id)
activate lh #00E5EE
return 3.1.3.2: lienHe
svc -> lh : 3.1.3.3: setStatus(trangThaiMoi),\nsetReplyNote(noiDungTraLoi) [nếu có]
activate lh #00E5EE
deactivate lh
alt Trạng thái mới là “Đã xử lý” hoặc “Thư rác”
  hnote over ad, lh : .
  svc -> lh : 3.1.3.4: setHandledBy(quanTriVien),\nsetHandledAt(thoiDiemHienTai)
  activate lh #00E5EE
  deactivate lh
else Trạng thái mới là “Đang xử lý” (hoặc “Mới”)
  hnote over ad, lh : .
  svc -> svc : 3.1.3.5: giữ nguyên người xử lý, thời điểm xử lý\n[liên hệ vẫn còn trong hàng đợi]
end
return 3.1.4: capNhatThanhCong
ctrl --> ui : 3.2: redirect:/admin/contacts kèm thông báo thành công
deactivate ctrl
ui -> ad : 3.3: Hiển thị lại danh sách kèm thông báo thành công,\nsố liên hệ mới trên menu cập nhật lại
deactivate ui
deactivate ad
@enduml
