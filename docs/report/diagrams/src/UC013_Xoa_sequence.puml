@startuml UC013_Xoa_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC013_Quản lý danh mục tour - Xoá danh mục]

actor "Quản trị viên" as kh
boundary "GiaoDien_DanhMuc" as ui
control "Ctrl_DanhMuc" as ctrl
control "Svc_DanhMuc" as svc
entity "Tour" as tour
entity "DanhMuc" as dm
kh -> ui : 1: Bấm “Xoá” ở một danh mục
ui --> kh : 1.1: Hộp xác nhận “Bạn chắc chắn muốn xoá mục này?”
alt Không đồng ý
  kh -> ui : 2: Huỷ hộp xác nhận
  ui --> kh : 2.1: Không gửi yêu cầu, danh mục giữ nguyên
else Đồng ý xoá
  kh -> ui : 3: Xác nhận xoá
  ui -> ctrl : 3.1: xoa(maDanhMuc)
  ctrl -> svc : 3.1.1: xoa(maDanhMuc)
  svc -> tour : 3.1.2: demTourTheoDanhMuc(maDanhMuc)
  tour --> svc : 3.1.3: soTour
  alt Còn tour thuộc danh mục
    svc --> ctrl : 3.1.4: lỗi “Không xoá được: danh mục này còn N tour ...”
    ctrl --> ui : 3.2: thông báo lỗi
    ui --> kh : 3.3: Hiện thông báo lỗi ngay trên trang, không xoá gì
  else Không còn tour
    svc -> dm : 3.1.5: xoa(maDanhMuc)
    dm --> svc : 3.1.6: xong
    svc -> svc : 3.1.7: xoaAnhDaiDienSauKhiXoa() [nếu là ảnh tự tải lên]
    svc --> ctrl : 3.1.8: xong
    ctrl --> ui : 3.4: xoá thành công
    ui --> kh : 3.5: Báo thành công và bỏ dòng vừa xoá, không tải lại trang
  end
end

@enduml
