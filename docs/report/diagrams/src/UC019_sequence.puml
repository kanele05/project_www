@startuml UC019_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC019_Xem thống kê doanh thu]

actor "Quản trị viên" as kh
boundary "GiaoDien_TongQuan" as ui
control "Ctrl_TongQuan" as ctrl
control "Ctrl_ThongKeApi" as api
control "Svc_ThongKe" as svc
entity "DonDat" as don
kh -> ui : 1: Mở trang tổng quan khu quản trị
ui -> ctrl : 1.1: tongQuan()
ctrl -> svc : 1.1.1: soLieuTongQuan()
svc -> don : 1.1.2: demTheoTrangThai(), tongDoanhThu(),\nsoTour, soKhachHang
don --> svc : 1.1.3: soLieu
svc --> ctrl : 1.1.4: soLieu
ctrl -> svc : 1.1.5: tourBanChay(5), donMoiNhat(5)
svc --> ctrl : 1.1.6: dsTour, dsDon
ctrl --> ui : 1.2: render(soLieu, tourBanChay, donMoiNhat)
ui --> kh : 1.3: Hiển thị thẻ số liệu, tour bán chạy, đơn mới nhất
ui -> api : 2: doanhThuTheoThang() [khi trang mở xong]
api -> svc : 2.1: doanhThuTheoThang()
svc -> don : 2.2: tongTheoThang(12 tháng gần nhất,\ntrạng thái Đã xác nhận / Hoàn thành)
don --> svc : 2.3: dsThang
svc --> api : 2.4: dsThang, tiLeSoVoiThangCaoNhat
api --> ui : 2.5: dsDiemDoanhThu
alt Chưa có doanh thu
  ui --> kh : 2.6: Hiển thị “chưa có dữ liệu”
else Có doanh thu
  ui --> kh : 2.7: Vẽ biểu đồ cột và bảng số liệu chi tiết
end
opt Bấm nút tải lại biểu đồ
  kh -> ui : 3: Bấm tải lại
  ui -> api : 3.1: doanhThuTheoThang()
  api --> ui : 3.2: dsDiemDoanhThu
  ui --> kh : 3.3: Vẽ lại biểu đồ, không tải lại trang
end

@enduml
