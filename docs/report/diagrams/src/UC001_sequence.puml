@startuml UC001_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC001_Tìm kiếm và lọc tour]

actor "Khách vãng lai" as kh
boundary "GiaoDien_TimKiem" as ui
control "Ctrl_Tour" as ctrl
control "Svc_TimKiem" as tk
control "Svc_Tour" as svc
entity "Tour" as tour
kh -> ui : 1: Mở trang “Tất cả tour”
ui -> ctrl : 1.1: danhSach(boLoc, trang)
ctrl -> tk : 1.1.1: timTour(boLoc, trang)
alt Không bật “Tìm bằng AI”
  tk -> svc : 1.1.2: timTheoTuKhoa(boLoc, trang)
  svc -> tour : 1.1.3: findAll(dieuKien, phanTrang)
  tour --> svc : 1.1.4: trangTour
  svc --> tk : 1.1.5: trangTour
else Bật “Tìm bằng AI” và AI sẵn sàng
  tk -> tk : 1.1.6: xepTheoDoPhuHop(moTa)
  opt Lỗi hoặc không có kết quả phù hợp
    tk -> svc : 1.1.7: timTheoTuKhoa(boLoc, trang)
    svc --> tk : 1.1.8: trangTour (chế độ dự phòng)
  end
end
tk --> ctrl : 1.1.9: trangTour, cheDoTim
ctrl --> ui : 1.2: render(trangTour)
ui --> kh : 1.3: Hiển thị danh sách, số kết quả và phân trang
opt Danh sách rỗng
  ui -> kh : 1.4: Hiển thị “Không có tour nào khớp ...”
end
kh -> ui : 2: Chuyển trang hoặc đổi ngôn ngữ
ui -> ctrl : 2.1: danhSach(boLoc giữ nguyên, trang mới)
ctrl --> ui : 2.2: trangTour
ui --> kh : 2.3: Hiển thị trang mới, giữ nguyên từ khoá và bộ lọc
@enduml
