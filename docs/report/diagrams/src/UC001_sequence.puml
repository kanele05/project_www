@startuml UC001_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC001_Xem trang chủ và giới thiệu]
actor "Khách vãng lai" as kh
boundary "GiaoDien_TrangChu" as ui
control "Ctrl_TrangChu" as ctrl
control "Svc_Tour" as svct
control "Svc_DanhMuc" as svcd
entity "Tour" as tour
entity "DanhMuc" as dm

kh -> ui : 1: Mở trang chủ hoặc bấm\nliên kết “Giới thiệu”
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrl : 1.1: home()
activate ctrl #00E5EE
ctrl -> svct : 1.1.1: layTourNoiBat(gioiHan)
activate svct #00E5EE
svct -> tour : 1.1.1.1: findByFeaturedTrueAndActiveTrue\nOrderByCreatedAtDesc(gioiHan)
activate tour #00E5EE
return 1.1.1.2: dsTourNoiBat
return 1.1.2: dsTourNoiBat
ctrl -> svcd : 1.1.3: layDanhMucDangHoatDong()
activate svcd #00E5EE
svcd -> dm : 1.1.3.1: findByActiveTrueOrderByNameAsc()
activate dm #00E5EE
return 1.1.3.2: dsDanhMuc
return 1.1.4: dsDanhMuc, soTourMoiDanhMuc
ctrl -> svct : 1.1.5: laySoLieuKhaiQuat()
activate svct #00E5EE
svct -> tour : 1.1.5.1: count()
activate tour #00E5EE
return 1.1.5.2: soTour, soDiemDen
return 1.1.6: soLieuKhaiQuat
ctrl --> ui : 1.2: render(dsTourNoiBat, dsDanhMuc, soLieu)
deactivate ctrl
alt Chưa có tour nào được đánh dấu nổi bật
  hnote over kh, dm : .
  ui -> kh : 1.3: Ẩn khối “Tour nổi bật”,\nhiển thị các khối còn lại
else Có tour nổi bật
  hnote over kh, dm : .
  ui -> kh : 1.4: Hiển thị banner, dải tour nổi bật kèm giá và ảnh,\ndanh mục, số liệu khái quát
end
deactivate ui
deactivate kh

opt Người dùng xem tiếp
  hnote over kh, dm : .
  kh -> ui : 2: Bấm vào một tour nổi bật\nhoặc một danh mục
  activate kh #00E5EE
  activate ui #00E5EE
  ui -> ui : 2.1: Chuyển sang UC003 hoặc UC002
  ui -> kh : 2.2: Hiển thị trang tương ứng
  deactivate ui
  deactivate kh
end
@enduml
