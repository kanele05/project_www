@startuml UC020_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC020_Kiểm duyệt đánh giá]

actor "Quản trị viên" as kh
boundary "GiaoDien_KiemDuyet" as ui
control "Ctrl_KiemDuyetDanhGia" as ctrl
control "Svc_DanhGia" as svc
entity "DanhGia" as dg
kh -> ui : 1: Chọn “Kiểm duyệt đánh giá” (hoặc đổi bộ lọc)
ui -> ctrl : 1.1: danhSach(boLoc = Chờ duyệt, trang)
ctrl -> svc : 1.1.1: danhSachQuanTri(boLoc, trang), demChoDuyet()
svc -> dg : 1.1.2: findTheoTrangThai(boLoc)
dg --> svc : 1.1.3: trangDanhGia
svc --> ctrl : 1.1.4: trangDanhGia, soChoDuyet
ctrl --> ui : 1.2: render(trangDanhGia)
ui --> kh : 1.3: Hiển thị danh sách và huy hiệu chờ duyệt
alt Duyệt / Bỏ duyệt
  kh -> ui : 2: Bấm “Duyệt” hoặc “Bỏ duyệt”
  ui -> ctrl : 2.1: duyet(maDanhGia) / boDuyet(maDanhGia)
  ctrl -> svc : 2.1.1: datDaDuyet(maDanhGia, true / false)
  svc -> dg : 2.1.2: capNhat(daDuyet)
  dg --> svc : 2.1.3: xong
  svc --> ctrl : 2.1.4: xong
  ctrl --> ui : 2.2: chuyển về danh sách kèm thông báo
  ui --> kh : 2.3: Duyệt: hiện công khai; bỏ duyệt: ẩn khỏi trang công khai
else Trả lời
  kh -> ui : 3: Bấm “Trả lời”, nhập nội dung, gửi
  ui -> ctrl : 3.1: traLoi(maDanhGia, noiDung)
  ctrl -> svc : 3.1.1: traLoi(maDanhGia, noiDung)
  alt Nội dung trống
    svc --> ctrl : 3.1.2: lỗi “Vui lòng nhập nội dung trả lời.”
    ctrl --> ui : 3.2: chuyển về danh sách kèm lỗi
    ui --> kh : 3.3: Hiển thị thông báo lỗi
  else Có nội dung
    svc -> dg : 3.1.3: ghiCauTraLoi(noiDung)
    dg --> svc : 3.1.4: xong
    svc --> ctrl : 3.1.5: xong
    ctrl --> ui : 3.4: chuyển về danh sách kèm thông báo
    ui --> kh : 3.5: Câu trả lời hiện dưới đánh giá (nếu đã duyệt)
  end
else Xoá
  kh -> ui : 4: Bấm “Xoá”
  ui -> ctrl : 4.1: xoa(maDanhGia)
  ctrl -> svc : 4.1.1: xoa(maDanhGia)
  svc -> dg : 4.1.2: delete(maDanhGia)
  dg --> svc : 4.1.3: xong
  svc --> ctrl : 4.1.4: xong
  ctrl --> ui : 4.2: chuyển về danh sách kèm thông báo
  ui --> kh : 4.3: Đánh giá biến mất, điểm trung bình tính lại
end

@enduml
