@startuml UC020_activity
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam RoundCorner 24
skinparam ArrowColor black
skinparam ArrowThickness 1.1
skinparam ConditionStyle diamond
skinparam ConditionEndStyle diamond
skinparam style strictuml
skinparam activity {
  BackgroundColor white
  BorderColor black
  BorderThickness 1
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
}
skinparam swimlane {
  BorderColor black
  BorderThickness 2
  TitleFontStyle bold
  TitleFontSize 16
}
skinparam wrapWidth 600
mainframe act [UC020_Kiểm duyệt đánh giá]
|Quản trị viên|
start
:Mở khu quản trị, chọn “Kiểm duyệt đánh giá”;
|Hệ thống|
:Hiển thị danh sách phân trang, mặc định “Chờ duyệt”
(tour, người viết, số sao, nhãn “Đã xác thực”);
|Quản trị viên|
:(Tuỳ chọn) chuyển bộ lọc sang “Đã duyệt” hoặc “Tất cả”;
:Chọn thao tác trên một đánh giá: Duyệt, Bỏ duyệt,
Trả lời (nhập nội dung) hoặc Xoá;
|Hệ thống|
if (Thao tác là “Duyệt”?) then (Có)
  :Đánh dấu đã duyệt; hiện ở trang tour,
tính vào điểm trung bình;
endif
if (Thao tác là “Bỏ duyệt”?) then (Có)
  :Đánh dấu chưa duyệt; ẩn khỏi trang công khai,
không tính vào điểm trung bình;
endif
if (Thao tác là “Trả lời”?) then (Có)
  if (Nội dung không trống?) then (Có)
    :Ghi câu trả lời, hiện dưới đánh giá
(nếu đánh giá đã duyệt);
  else (Không)
    :Từ chối: “Vui lòng nhập nội dung trả lời.”;
  endif
endif
if (Thao tác là “Xoá”?) then (Có)
  :Xoá hẳn đánh giá, tính lại điểm
trung bình của tour;
endif
:Hiển thị lại danh sách kèm thông báo kết quả;
|Quản trị viên|
stop
@enduml
