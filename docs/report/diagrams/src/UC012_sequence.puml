@startuml UC012_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC012_Xem thống kê doanh thu]
actor "Quản trị viên" as ad
boundary "GiaoDien_TongQuan" as ui
control "Ctrl_TongQuan" as ctrl
control "Ctrl_ThongKeApi" as api
control "Svc_ThongKe" as svc
entity "DonDat" as don

ad -> ui : 1: Mở trang tổng quan khu quản trị\n(sau khi đăng nhập với vai trò quản trị viên)
activate ad #00E5EE
activate ui #00E5EE
ui -> ctrl : 1.1: dashboard()
activate ctrl #00E5EE
ctrl -> svc : 1.1.1: laySoLieuKhaiQuat()
activate svc #00E5EE
svc -> don : 1.1.1.1: countByStatus(moiTrangThai), count()
activate don #00E5EE
return 1.1.1.2: soDonTheoTrangThai, tongSoDon
svc -> don : 1.1.1.3: sumTotalAmountForStatuses(daXacNhan, hoanTat)
activate don #00E5EE
return 1.1.1.4: tongDoanhThu
return 1.1.2: soLieuKhaiQuat
ctrl --> ui : 1.2: render(soLieuKhaiQuat)
deactivate ctrl
ui -> ad : 1.3: Hiển thị các số liệu khái quát dưới dạng thẻ số liệu
deactivate ui
deactivate ad

ui -> api : 2: [trang tải xong] GET /api/admin/stats/revenue
activate ui #00E5EE
activate api #00E5EE
api -> svc : 2.1: doanhThuTheoThang()
activate svc #00E5EE
svc -> don : 2.1.1: revenueByMonth(tuNgay, daXacNhan, hoanTat)\n[12 tháng gần nhất]
activate don #00E5EE
return 2.1.2: dsDongDoanhThu
alt Chưa có đơn nào đã xác nhận hoặc hoàn tất
  hnote over ad, don : .
  svc --> api : 2.2: danhSachRong
  api --> ui : 2.3: []
  ui -> ad : 2.4: Hiển thị “chưa có dữ liệu”
else Có dữ liệu doanh thu
  hnote over ad, don : .
  svc -> svc : 2.1.3: tinhPhanTramSoVoiThangCaoNhat()
  svc --> api : 2.2: dsDoanhThuTheoThang
  api --> ui : 2.3: dsDiemDoanhThu (JSON)
  ui -> ad : 2.4: Vẽ biểu đồ cột doanh thu theo tháng,\ncó nhãn số tiền và đường kẻ mốc
end
deactivate svc
deactivate api
deactivate ui
@enduml
