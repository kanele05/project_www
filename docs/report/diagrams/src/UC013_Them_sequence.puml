@startuml UC013_Them_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 160
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 12
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC013_Quản lý danh mục tour - Thêm danh mục]

actor "Quản trị viên" as kh
boundary "GiaoDien_DanhMuc" as ui
control "Ctrl_DanhMuc" as ctrl
control "Svc_DanhMuc" as svc
entity "DanhMuc" as dm
kh -> ui : 1: Bấm “Thêm danh mục”
ui -> ctrl : 1.1: bieuMauThem()
ctrl --> ui : 1.2: bieuMau (trống)
ui --> kh : 1.3: Hiển thị biểu mẫu thêm danh mục trống
kh -> ui : 2: Nhập tên, mô tả, ảnh, “Hiển thị”, bấm “Lưu”
ui -> ctrl : 2.1: luu(bieuMau)
ctrl -> ctrl : 2.1.1: kiemTra(bieuMau): tên bắt buộc ≤ 100,\nmô tả ≤ 500 ký tự
alt Dữ liệu không hợp lệ
  ctrl --> ui : 2.2: trả lại biểu mẫu kèm lỗi tại đúng ô
  ui --> kh : 2.3: Hiển thị lỗi tại đúng ô
else Dữ liệu hợp lệ
  ctrl -> svc : 2.1.2: luu(bieuMau)
  svc -> dm : 2.1.3: tonTaiTheoTen(ten)
  dm --> svc : 2.1.4: ketQua
  alt Tên đã tồn tại
    svc --> ctrl : 2.1.5: lỗi “Danh mục ... đã tồn tại.”
    ctrl --> ui : 2.4: trả lại biểu mẫu kèm lỗi tại ô tên
    ui --> kh : 2.5: Hiển thị lỗi, giữ nguyên giá trị đã nhập
  else Tên chưa tồn tại
    svc -> svc : 2.1.6: sinhDuongDanDuyNhat(ten)
    svc -> svc : 2.1.7: luuAnhDaiDien(anh)
    opt Ảnh không hợp lệ
      svc --> ctrl : 2.1.8: lỗi ảnh (không lưu gì)
    end
    svc -> dm : 2.1.9: «create» DanhMuc(ten, moTa, duongDan, hienThi)
    dm --> svc : 2.1.10: danhMucDaLuu
    svc --> ctrl : 2.1.11: danhMucDaLuu
    ctrl --> ui : 2.6: chuyển về danh sách kèm thông báo
    ui --> kh : 2.7: Hiển thị danh sách và thông báo tạo thành công
  end
end

@enduml
