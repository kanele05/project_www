@startuml UC002_sequence
skinparam dpi 140
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam shadowing false
skinparam style strictuml
hide footbox
skinparam maxMessageSize 420
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow false
skinparam ArrowColor black
skinparam ParticipantPadding 90
skinparam BoxPadding 6
skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  LifeLineBackgroundColor #00E5EE
  ParticipantBackgroundColor #00E5EE
  ParticipantBorderColor black
  ActorBackgroundColor #00E5EE
  ActorBorderColor black
  GroupBorderColor black
  GroupBackgroundColor white
  GroupHeaderFontStyle bold
  GroupFontStyle plain
  GroupBorderThickness 1.2
}
skinparam note {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}
skinparam BoundaryBackgroundColor #00E5EE
skinparam BoundaryBorderColor black
skinparam ControlBackgroundColor #00E5EE
skinparam ControlBorderColor black
skinparam EntityBackgroundColor #00E5EE
skinparam EntityBorderColor black
skinparam ActorBackgroundColor #00E5EE
skinparam ActorBorderColor black
mainframe sd [UC002_Tìm kiếm và lọc tour]
actor "Khách vãng lai" as kh
boundary "GiaoDien_TimKiemTour" as ui
control "Ctrl_Tour" as ctrl
control "Svc_TimKiem" as svck
control "Svc_Tour" as svct
entity "Tour" as tour

kh -> ui : 1: Mở trang “Tìm kiếm tour”\ntừ thanh điều hướng
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrl : 1.1: list(searchForm, page = 0)
activate ctrl #00E5EE
ctrl -> svck : 1.1.1: timKiem(form, trang)
activate svck #00E5EE
svck -> svct : 1.1.1.1: timTour(form, trang)\n[chế độ từ khoá]
activate svct #00E5EE
svct -> tour : 1.1.1.1.1: findAll(dieuKienLoc, phanTrang)
activate tour #00E5EE
return 1.1.1.1.2: trangTour
return 1.1.1.2: trangTour
return 1.1.2: trangTour
ctrl -> svct : 1.1.3: layDanhSachDiemDen()
activate svct #00E5EE
svct -> tour : 1.1.3.1: findAllDestinations()
activate tour #00E5EE
return 1.1.3.2: dsDiemDen
return 1.1.4: dsDiemDen
ctrl --> ui : 1.2: render(trangTour, dsDiemDen)
deactivate ctrl
ui -> kh : 1.3: Hiển thị biểu mẫu tìm kiếm/lọc\nvà trang đầu của danh sách
deactivate ui
deactivate kh

kh -> ui : 2: Nhập từ khoá và/hoặc chọn danh mục,\nđiểm đến, khoảng giá, bấm “Tìm”
activate kh #00E5EE
activate ui #00E5EE
ui -> ctrl : 2.1: list(searchForm, page = 0)
activate ctrl #00E5EE
ctrl -> svck : 2.1.1: timKiem(form, trang)
activate svck #00E5EE
svck -> svct : 2.1.1.1: timTour(form, trang)
activate svct #00E5EE
svct -> svct : 2.1.1.2: chuanHoaTuKhoa(tuKhoa):\nbỏ dấu, chữ thường
svct -> tour : 2.1.1.3: findAll(dieuKienLoc, phanTrang)\nkhớp trên search_text + danh mục, điểm đến, giá
activate tour #00E5EE
return 2.1.1.4: trangTour
return 2.1.2: trangTour
return 2.1.3: trangTour
ctrl --> ui : 2.2: render(trangTour)
deactivate ctrl
alt Không có tour nào khớp điều kiện
  hnote over kh, tour : .
  ui -> kh : 2.3: Hiển thị “Không tìm thấy tour phù hợp”\nkèm gợi ý xoá bớt bộ lọc
else Có tour khớp điều kiện
  hnote over kh, tour : .
  ui -> kh : 2.4: Hiển thị danh sách tour kèm số lượng\nkết quả và điều khiển phân trang
end
deactivate ui
deactivate kh

opt Người dùng chuyển trang hoặc đổi ngôn ngữ
  hnote over kh, tour : .
  kh -> ui : 3: Chuyển sang trang kế tiếp\nhoặc đổi ngôn ngữ hiển thị
  activate kh #00E5EE
  activate ui #00E5EE
  ui -> ctrl : 3.1: list(searchForm, page)
  activate ctrl #00E5EE
  ctrl -> svck : 3.1.1: timKiem(form, trang)
  activate svck #00E5EE
  svck -> svct : 3.1.1.1: timTour(form, trang)
  activate svct #00E5EE
  svct -> tour : 3.1.1.2: findAll(dieuKienLoc, phanTrang)
  activate tour #00E5EE
  return 3.1.1.3: trangTour
  return 3.1.2: trangTour
  return 3.1.3: trangTour
  ctrl --> ui : 3.2: render(trangTour, pageUrlPrefix)\n[giữ nguyên từ khoá và bộ lọc]
  deactivate ctrl
  ui -> kh : 3.3: Hiển thị trang mới, giữ nguyên\ntừ khoá và bộ lọc đang áp dụng
  deactivate ui
  deactivate kh
end
@enduml
